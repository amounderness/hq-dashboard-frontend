{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:visual:explorer-v2": "node tools/test_explorer_v2_browser.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "d3-geo": "3.1.1",
    "jose": "6.2.12",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.17",
    "typescript": "^5",
    "vite": "^8.3.1",
    "wrangler": "^4.140.0"
  },
  "type": "module",
  "optionalDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.11",
    "@rolldown/binding-win32-x64-msvc": "^1.2.11"
  }
}
