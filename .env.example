# Copy to .env.local for local development. Never commit .env.local.
# Absolute path to the validated local Leeds package directory.
SWITCHBOARD_PACKAGE_DIR=
# Use only while developing on localhost. Production ignores this bypass.
SWITCHBOARD_ALLOW_LOCAL_UNAUTHENTICATED=true

# Required in production for Cloudflare Access JWT verification.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUD=your-application-audience-tag
