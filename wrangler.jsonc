{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard-owner-preview",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "vars": {
    "SWITCHBOARD_DEMO_MODE": "false",
    "SWITCHBOARD_PACKAGE_STORE": "r2",
    "SWITCHBOARD_V2_VIEWER_ENABLED": "true",
    "SWITCHBOARD_V2_ENABLED": "false",
    "SWITCHBOARD_OWNER_EMAIL": "keenanrclough@gmail.com",
    "ACCESS_TEAM_DOMAIN": "https://keenanrclough.cloudflareaccess.com",
    "ACCESS_AUD": "c7ad3f4cbf48f3efc916ee462cb435c758b02767b03ab24651cc688ee9310a26"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "SWITCHBOARD_PACKAGES",
      "bucket_name": "switchboard-private-packages"
    }
  ]
}
